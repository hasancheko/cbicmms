<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="20261116-1" author="hasancheko">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="work_order_meter_trigger" columnName="last_triggered_value"/>
            </not>
        </preConditions>
        <addColumn tableName="work_order_meter_trigger">
            <column name="last_triggered_value" type="double precision"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
